# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server only, NEVER expose to the browser. Used by API
# routes and dashboard server components to bypass RLS for protected reads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random long random string used to sign the dashboard session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Which business row this deployment serves (see supabase/seed.sql).
# Simplifies a single-tenant deployment; the schema supports multiple
# businesses if you want to extend it later.
NEXT_PUBLIC_BUSINESS_SLUG=default
